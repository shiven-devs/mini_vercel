# Copy values into a dedicated local shell or a simulator-only environment file.
SIMULATION_MODE=true
TARGET_URL=http://localhost:8000
SECURITY_SIMULATION_TOKEN=replace-with-a-long-random-test-token
SECURITY_WEBHOOK_HMAC_SECRET=replace-with-a-long-random-test-secret
SIMULATION_MAX_REQUESTS=120
SIMULATION_TIMEOUT_MS=15000

# These defaults match the proxy defaults. Lower the proxy thresholds in a test-only
# environment if you need shorter scenarios.
SIMULATION_PATH_REQUESTS=30
SIMULATION_LOGIN_FAILURES=10
SIMULATION_FLOOD_REQUESTS=105

# Optional: permits one explicit staging origin, for example https://security-staging.example.com
AUTHORIZED_SIMULATION_TARGETS=

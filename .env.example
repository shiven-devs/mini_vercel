# Copy this file to .env and fill in values for your environment.

# Shared Redis connection used by the API log subscriber and build publisher
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT

# AWS credentials for local development only. In ECS, use a task role instead.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# ECS settings used by api-server
ECS_CLUSTER_ARN=arn:aws:ecs:REGION:ACCOUNT_ID:cluster/CLUSTER_NAME
ECS_TASK_DEFINITION_ARN=arn:aws:ecs:REGION:ACCOUNT_ID:task-definition/TASK_DEFINITION_NAME
ECS_SUBNETS=subnet-xxxxxxxx,subnet-yyyyyyyy
ECS_SECURITY_GROUPS=sg-xxxxxxxx

# S3 settings used by build_server and s3-reverse-proxy
AWS_S3_BUCKET=YOUR_S3_BUCKET
S3_OUTPUT_BASE_URL=https://YOUR_S3_BUCKET.s3.ap-southeast-2.amazonaws.com/__outputs

# Local service ports
API_PORT=9000
SOCKET_PORT=9002
PROXY_PORT=8000

# Reverse-proxy host validation and Socket.IO access control
# A deployed site is addressed as <project-id>.<PROXY_ALLOWED_HOST_SUFFIX>.
PROXY_ALLOWED_HOST_SUFFIX=localhost
DEFAULT_PROJECT_ID=default-project
SOCKET_AUTH_TOKEN=replace-with-a-long-random-socket-token

# Security event pipeline. Redis Streams are bounded; the same Redis URL above is used.
SECURITY_REDIS_STREAM_MAXLEN=10000
SECURITY_TRUSTED_PROXY_IPS=loopback
SECURITY_PATH_WINDOW_SECONDS=10
SECURITY_PATH_UNIQUE_THRESHOLD=30
SECURITY_PATH_MIN_REQUESTS=30
SECURITY_PATH_404_RATIO_THRESHOLD=0.60
SECURITY_BRUTE_FORCE_WINDOW_SECONDS=60
SECURITY_BRUTE_FORCE_FAILURE_THRESHOLD=10
SECURITY_RATE_WINDOW_SECONDS=10
SECURITY_RATE_MAX_REQUESTS=100
SECURITY_ALERT_COOLDOWN_SECONDS=60
SECURITY_REPLAY_TIMESTAMP_TOLERANCE_SECONDS=300
SECURITY_REPLAY_NONCE_TTL_SECONDS=300

# Disabled in production. Required only for local/staging attack simulations.
SIMULATION_MODE=false
SECURITY_DEMO_ENDPOINTS_ENABLED=false
SECURITY_SIMULATION_TOKEN=replace-with-a-long-random-simulation-token
SECURITY_DEMO_PROJECT_ID=security-demo
SECURITY_DEMO_LOGIN_USERNAME=demo-user
SECURITY_DEMO_LOGIN_PASSWORD=replace-with-a-dummy-test-password
SECURITY_WEBHOOK_HMAC_SECRET=replace-with-a-long-random-webhook-secret

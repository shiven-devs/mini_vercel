# Copy this file to .env and fill in values for your environment.

# Shared Redis connection used by the API log subscriber and build publisher
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT

# AWS credentials for local development only. In ECS, use a task role instead.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# ECS settings used by api-server
ECS_CLUSTER_ARN=arn:aws:ecs:REGION:ACCOUNT_ID:cluster/CLUSTER_NAME
ECS_TASK_DEFINITION_ARN=arn:aws:ecs:REGION:ACCOUNT_ID:task-definition/TASK_DEFINITION_NAME
ECS_SUBNETS=subnet-xxxxxxxx,subnet-yyyyyyyy
ECS_SECURITY_GROUPS=sg-xxxxxxxx

# S3 settings used by build_server and s3-reverse-proxy
AWS_S3_BUCKET=YOUR_S3_BUCKET
S3_OUTPUT_BASE_URL=https://YOUR_S3_BUCKET.s3.ap-southeast-2.amazonaws.com/__outputs

# Local service ports
API_PORT=9000
SOCKET_PORT=9002
PROXY_PORT=8000
